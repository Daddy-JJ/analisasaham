# ===================================================
# KONFIGURASI GEMINI PRO & DATA PASAR (IDX PRO)
# ===================================================

# 1. Google Gemini API Key (Wajib)
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (Rekomendasi: gemini-1.5-pro atau gemini-2.5-pro / gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# 2. MAXLONG API (Opsional / Masa Depan)
# Jika di masa depan Anda memiliki API Key dari https://eod.maxlong.my.id
MAXLONG_API_BASE_URL=https://eod.maxlong.my.id
MAXLONG_API_KEY=
